# 复制为 .env 后填写（.env 已被 .gitignore 忽略）

PORT=8787

# 上游地址（MiniMax 国内站示例）
UPSTREAM_BASE_URL=https://api.minimaxi.com

# Anthropic 兼容协议的路径前缀；若用 OpenAI 兼容协议则留空，并把上游改为 https://api.minimaxi.com/v1
UPSTREAM_PATH_PREFIX=/anthropic

# 鉴权头：bearer（多数国内兼容端点）或 x-api-key（Anthropic 官方）
UPSTREAM_AUTH_HEADER=bearer

# 上游 API Key，只保存在本机，不会传给浏览器
UPSTREAM_API_KEY=
